{"nodes": [{"id": "readme_agentscrape", "label": "agentscrape", "file_type": "document", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_contact_extraction_platform", "label": "Contact Extraction Platform", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_single_box_architecture", "label": "Single-Box Architecture", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The API, orchestrator, agents, PostgreSQL, and file storage run on one intermittently operated server, favoring simple local coordination and storage."}, {"id": "readme_spreadsheet_ground_truth", "label": "Client Spreadsheet Ground Truth", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_specialty_coverage_check", "label": "Specialty-Grouped Coverage Check", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Coverage grouped by specialty distinguishes discovery or ranking failures from extraction failures spread across visited pages."}, {"id": "readme_site_processing_pipeline", "label": "Site Processing Pipeline", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_institution_validation", "label": "Institution Validation", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "K-12 institutions are rejected before extraction compute is spent, using hostname and homepage evidence before consulting a model."}, {"id": "readme_two_tier_skip_check", "label": "Two-Tier Skip Check", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Known-page content hashes provide a cheap first check, while address-set Jaccard similarity supplies a second check when content changed."}, {"id": "readme_cross_host_discovery", "label": "Cross-Host Roster Discovery", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Departmental rosters often live on sibling hosts, so discovery walks sitemaps for in-scope hosts revealed by the site and filters unrelated sibling hosts by label."}, {"id": "readme_candidate_ranking", "label": "Candidate Page Ranking", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ranking emphasizes the URL leaf and token sets, vetoes news-like sections, and prioritizes current rosters while retaining lower-ranked faculty and alumni listings."}, {"id": "readme_dynamic_frontier", "label": "Dynamic Extraction Frontier", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Links discovered during extraction are scored into only the unvisited tail so newly found rosters can move forward without invalidating the loop cursor or refetching pages."}, {"id": "readme_cost_escalating_extraction", "label": "Cost-Escalating Extraction", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plain HTML is always attempted first; browser rendering, screenshots, interaction, and vision are used only when page evidence shows cheaper parsing is insufficient."}, {"id": "readme_barren_page_early_stop", "label": "Barren-Page Early Stop", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A consecutive barren stretch in a ranked candidate list indicates productive pages are likely exhausted; the counter tracks people found so unchanged re-scrapes do not stop prematurely."}, {"id": "readme_accessibility_tree_interaction", "label": "Accessibility-Tree Browser Interaction", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Browser actions identify elements by accessibility role and name instead of predicted screenshot coordinates; vision reads content and disambiguates links but does not produce click targets."}, {"id": "readme_record_reconciliation", "label": "Record Reconciliation", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-site PostgreSQL advisory locks prevent interleaved writes, records remain immutable through versions, and a person is marked missing only after the source page was successfully revisited."}, {"id": "readme_field_level_provenance", "label": "Field-Level Provenance", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_screenshot_retention", "label": "Latest-Run Screenshot Retention", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the most recent run's images are retained to bound local storage, while textual provenance and field locations survive supersession."}, {"id": "readme_site_runs_work_queue", "label": "site_runs Work Queue", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A PostgreSQL row-backed queue with FOR UPDATE SKIP LOCKED provides atomic claims, restart survival, and no separate broker within the single-box architecture."}, {"id": "readme_checkpointed_resume", "label": "Checkpointed Mid-Site Resume", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Persisting the ranked list and cursor after each batch lets interrupted runs resume extraction without repeating discovery, while per-batch reconciliation preserves collected results."}, {"id": "readme_resource_and_spend_limits", "label": "Resource and Spend Limits", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Concurrency is rejected when it exceeds available memory, and live record and spend counters stop new claims while allowing in-flight work to drain into valid partial results."}, {"id": "readme_postgresql", "label": "PostgreSQL", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "readme_agentscrape", "target": "readme_contact_extraction_platform", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "README.md", "source_location": null, "weight": 1.0}, {"source": "readme_agentscrape", "target": "readme_single_box_architecture", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "sour