# --- auth ---------------------------------------------------------------
APP_PASSWORD=change-me
TOKEN_TTL_HOURS=720

# --- database -----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://agentscrape:agentscrape@localhost:5433/agentscrape

# --- model provider (OpenAI-compatible) ---------------------------------
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=not-needed
LLM_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
LLM_PRICE_INPUT_PER_MTOK=0.30
LLM_PRICE_OUTPUT_PER_MTOK=0.90
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3

# --- crawling -----------------------------------------------------------
USER_AGENT=agentscrape/0.1 (+contact: ops@example.com)
RESPECT_ROBOTS=false
REQUESTS_PER_SECOND_PER_DOMAIN=2.0
IN_SITE_FETCH_CONCURRENCY=4
PAGE_TIMEOUT_SECONDS=30
FETCH_TIMEOUT_SECONDS=20

# --- discovery ----------------------------------------------------------
MAX_CANDIDATES=150
DISCOVERY_TIMEOUT_SECONDS=180
DISCOVERY_SOURCE_TIMEOUT_SECONDS=60
ENABLE_CRT_SH=true
CRT_SH_TIMEOUT_SECONDS=30
SEARCH_PROVIDER=none
SEARCH_API_KEY=

# --- run defaults -------------------------------------------------------
DEFAULT_CONCURRENCY=4
MAX_CONCURRENCY=8
DEFAULT_SKIP_THRESHOLD=0.90
DEFAULT_STEP_BUDGET=40
RUN_TIMEOUT_SECONDS=86400
MAX_CONCURRENT_CONTEXTS=8
ESTIMATED_MB_PER_CONTEXT=350
MEMORY_SAFETY_FACTOR=0.75

# --- retention (null = keep forever) ------------------------------------
ARTIFACT_DIR=./artifacts
SCREENSHOT_RETENTION_DAYS=
VERSION_RETENTION_DAYS=
EXPORT_RETENTION_DAYS=7
