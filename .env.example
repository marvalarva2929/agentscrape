# --- auth ---------------------------------------------------------------
APP_PASSWORD=change-me
ADMIN_PASSWORD=change-me-admin
TOKEN_TTL_HOURS=720
ARTIFACT_LINK_TTL_SECONDS=3600
# Comma-separated. Add the GitHub Pages origin for deployed builds.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- database -----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://agentscrape:agentscrape@localhost:5433/agentscrape

# --- model provider (OpenAI-compatible) ---------------------------------
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_API_KEY=not-needed
LLM_MODEL=Qwen/Qwen3-VL-235B-A22B-Instruct
LLM_PRICE_INPUT_PER_MTOK=0.30
LLM_PRICE_OUTPUT_PER_MTOK=0.90
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=6
# Hugging Face router: LLM_API_KEY is your hf_... token.
# Text-only calls (reading, triage, planning); blank means LLM_MODEL.
LLM_TEXT_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507
# Link and host triage (high volume, low stakes); blank means LLM_TEXT_MODEL.
# It must be served by a provider enabled on the account (`agentscrape
# llm-check` tests it); Qwen3-30B-A3B-Instruct-2507 is not on the HF router.
LLM_CHEAP_MODEL=
LLM_CHEAP_PRICE_INPUT_PER_MTOK=0.10
LLM_CHEAP_PRICE_OUTPUT_PER_MTOK=0.30
LLM_MAX_OUTPUT_TOKENS=16000
LLM_CONCURRENCY=8
LLM_PAGE_CHUNK_CHARS=20000
LLM_MAX_CONSECUTIVE_FAILURES=20

# --- crawling -----------------------------------------------------------
USER_AGENT=agentscrape/0.1 (+contact: ops@example.com)
RESPECT_ROBOTS=false
REQUESTS_PER_SECOND_PER_DOMAIN=2.0
IN_SITE_FETCH_CONCURRENCY=4
PAGE_TIMEOUT_SECONDS=30
FETCH_TIMEOUT_SECONDS=20

# --- discovery ----------------------------------------------------------
MAX_CANDIDATES=20000
DISCOVERY_TIMEOUT_SECONDS=180
DISCOVERY_SOURCE_TIMEOUT_SECONDS=60
ENABLE_CRT_SH=true
CRT_SH_TIMEOUT_SECONDS=30
SEARCH_PROVIDER=none
SEARCH_API_KEY=

# --- run defaults -------------------------------------------------------
DEFAULT_CONCURRENCY=4
MAX_CONCURRENCY=8
DEFAULT_SKIP_THRESHOLD=0.90
DEFAULT_STEP_BUDGET=5000
STOP_AFTER_BARREN_PAGES=150
RUN_TIMEOUT_SECONDS=86400
MAX_CONCURRENT_CONTEXTS=8
ESTIMATED_MB_PER_CONTEXT=350
MEMORY_SAFETY_FACTOR=0.75

# --- retention (null = keep forever) ------------------------------------
ARTIFACT_DIR=./artifacts
SCREENSHOT_RETENTION_DAYS=
VERSION_RETENTION_DAYS=
EXPORT_RETENTION_DAYS=7

# --- demo -----------------------------------------------------------------
# Listed first in the UI, so the app opens on it.
FEATURED_SCHOOL=medicine.arizona.edu
